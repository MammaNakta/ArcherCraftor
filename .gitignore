# ================================
# Unity Project .gitignore
# ================================

# [Unity Cache & Temporary Folders]
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]uto[Gg]enerated/
/[Uu]nity[Cc]onfiguration/

# [Asset Backups & Store Tools]
/[Aa]ssets/AssetStoreTools*
/[Aa]sset[Ss]tore[Tt]ools*

# [Autogenerated Visual Studio / IDE Solution Files]
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# [Unity Generated Diagnostics & Dumps]
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.stackdump

# [Unity Test Runner Results]
/[Tt]est[Rr]esults/
[Tt]est[Rr]esults.xml
TestResults*.xml

# [Unity Package Manager Local Cache & Artifacts]
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
.gradle/
.utmp/

# [Crash Reports]
crashlytics-build.properties

# [Visual Studio & VS Code]
.vs/
.vscode/

# [JetBrains Rider]
.idea/
*.sln.iml
*.DotSettings.user

# [Private & Sensitive Keys/Files]
*.private
*.private.meta
.env
.env.*
!.env.example
*.keystore
*.jks
*.publishsettings

# [OS Generated Files]
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.directory
